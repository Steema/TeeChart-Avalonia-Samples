<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:teechart="clr-namespace:Steema.TeeChart.Avalonia;assembly=TeeChart.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RealtimeDash.MainWindow"
        Title="RealtimeDash"
		WindowStartupLocation="CenterScreen">
	
	<Window.Styles>
		<Style Selector="Button.button">
			<Setter Property="Background" Value="LightGray" />
			<Setter Property="Foreground" Value="Black" />
		</Style>

		<Style Selector="Button.button:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="DarkGray" />
			<Setter Property="Foreground" Value="Black" />
		</Style>
	</Window.Styles>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="1*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="1*" />
			<RowDefinition Height="1*" />
			<RowDefinition Height="1*" />
			<RowDefinition Height="1*" />
			<RowDefinition Height="1*" />
		</Grid.RowDefinitions>
		<teechart:TChart Name="tChart7" Grid.RowSpan="2"></teechart:TChart>
		<teechart:TChart Name="tChart5" Grid.Column="1" Grid.RowSpan="2"></teechart:TChart>
		<Button Name="StartStop" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Classes="button">Start Stop</Button>
		<teechart:TChart Name="tChart2" Grid.Column="2" Grid.Row="0"></teechart:TChart>
		<teechart:TChart Name="tChart3" Grid.Column="2" Grid.Row="1"></teechart:TChart>
		<teechart:TChart Name="tChart8" Grid.Column="0" Grid.Row="2" Grid.RowSpan="3"></teechart:TChart>
		<teechart:TChart Name="tChart6" Grid.Column="1" Grid.Row="2" Grid.RowSpan="3"></teechart:TChart>
		<teechart:TChart Name="tChart4" Grid.Column="2" Grid.Row="2"></teechart:TChart>
		<teechart:TChart Name="tChart9" Grid.Column="2" Grid.Row="3"></teechart:TChart>
		<teechart:TChart Name="tChart1" Grid.Column="2" Grid.Row="4"></teechart:TChart>
	</Grid>
</Window>
